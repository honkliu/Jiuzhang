<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KanKan.API</AssemblyName>
    <RootNamespace>KanKan.API</RootNamespace>
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.81.0" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.5" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs;bin\**\*.cs;obj_*\**\*.cs;bin_*\**\*.cs" />
    <EmbeddedResource Remove="obj\**\*;bin\**\*;obj_*\**\*;bin_*\**\*" />
    <None Remove="obj\**\*;bin\**\*;obj_*\**\*;bin_*\**\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Domain\Homm\h3-rules.json" LogicalName="KanKan.API.Homm.NativeRules.json" />
    <EmbeddedResource Include="Domain\Homm\object-geometry.json" LogicalName="KanKan.API.Homm.ObjectGeometry.json" />
  </ItemGroup>

</Project>
